{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "prebuildCommand": "npm i --force",
      "ios": {
        "credentialsSource": "local",
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
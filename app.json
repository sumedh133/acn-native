{
  "expo": {
    "name": "ACN",
    "displayName": "ACN",
    "slug": "acn-native",
    "version": "1.2.1",
    "scheme": "com.acnonline.in",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.acnonline.in",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "itms-apps",
          "itms-apps"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.acnonline.in"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-firebase/app",
        {
          "appCheck": {
            "debug": true
          }
        }
      ],
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_screen.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#153E3B"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCanary":true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bed248dc-419b-4fd9-80c2-49ba8d271313"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/bed248dc-419b-4fd9-80c2-49ba8d271313"
    }
  }
}
